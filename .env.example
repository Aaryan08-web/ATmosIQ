# Copy to .env and fill in. Never commit .env.
PORT=8080
# Required in production: long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Set to false ONLY if serving over plain HTTP (e.g. EC2 without a load balancer/TLS)
COOKIE_SECURE=true
DB_PATH=./data/atmosiq.db
# Optional: comma-separated emails that get the admin role when they sign up
ADMIN_EMAILS=

# NASA FIRMS map key (free): https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here
# Gemini API key (https://aistudio.google.com/apikey). Server-side only.
GEMINI_API_KEY=your_gemini_api_key_here
# Google restricts gemini-2.5-* to existing users; new keys should use a 3.x model (see ai.google.dev/gemini-api/docs/deprecations)
GEMINI_MODEL=gemini-3.8-flash
# Application public URL (e.g. https://atmosiq.example.com)
APP_URL=
# Global Forest Watch Data API key: https://data-api.globalforestwatch.org
GFW_API_KEY=your_gfw_api_key_here
# GFW API Origin: Domain registered in WRI Developer Portal allowlist for your GFW_API_KEY.
# For local development: http://localhost:3000
# For production deployment: https://your-production-domain.com (defaults to APP_URL if set)
GFW_API_ORIGIN=http://localhost:3000
# GFW background synchronization interval in minutes (default 360 = 6 hours)
GFW_SYNC_INTERVAL_MINUTES=360
